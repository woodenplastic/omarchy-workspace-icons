#!/usr/bin/python3
"""Tray icon for Workspace Icons: a StatusNotifierItem with a standard tray
menu (com.canonical.dbusmenu) holding the widget's settings, so Omarchy's tray
draws and places the menu like any other tray app's. Started and stopped by the
widget while its plugin symbol is set to the tray. Uses the system Python's
PyGObject, which Omarchy ships.

The menu reads the current settings from ~/.config/omarchy/shell.json and
changes them through scripts/config and the omarchy commands, the same way the
settings popup does."""

import json
import os
import subprocess
import sys

from gi.repository import Gio, GLib

PLUGIN_ID = "woodenplastic.workspace-icons"
# One tray icon, even with a bar (and so a widget) on every monitor.
UNIQUE_NAME = "io.github.woodenplastic.WorkspaceIcons"
ITEM_PATH = "/StatusNotifierItem"
MENU_PATH = "/MenuBar"
PLUGIN_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
ICON_DIR = os.path.join(PLUGIN_DIR, "icons")
CONFIG_SCRIPT = os.path.join(PLUGIN_DIR, "scripts", "config")
SHELL_CONFIG = os.path.expanduser("~/.config/omarchy/shell.json")

INTERFACES = """
<node>
  <interface name="org.kde.StatusNotifierItem">
    <property name="Category" type="s" access="read"/>
    <property name="Id" type="s" access="read"/>
    <property name="Title" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="IconName" type="s" access="read"/>
    <property name="IconThemePath" type="s" access="read"/>
    <property name="ItemIsMenu" type="b" access="read"/>
    <property name="Menu" type="o" access="read"/>
    <property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
    <method name="Activate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="SecondaryActivate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="ContextMenu"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
    <method name="Scroll"><arg name="delta" type="i" direction="in"/><arg name="orientation" type="s" direction="in"/></method>
    <signal name="NewIcon"/>
    <signal name="NewStatus"><arg name="status" type="s"/></signal>
  </interface>
  <interface name="com.canonical.dbusmenu">
    <property name="Version" type="u" access="read"/>
    <property name="TextDirection" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="IconThemePath" type="as" access="read"/>
    <method name="GetLayout">
      <arg name="parentId" type="i" direction="in"/>
      <arg name="recursionDepth" type="i" direction="in"/>
      <arg name="propertyNames" type="as" direction="in"/>
      <arg name="revision" type="u" direction="out"/>
      <arg name="layout" type="(ia{sv}av)" direction="out"/>
    </method>
    <method name="GetGroupProperties">
      <arg name="ids" type="ai" direction="in"/>
      <arg name="propertyNames" type="as" direction="in"/>
      <arg name="properties" type="a(ia{sv})" direction="out"/>
    </method>
    <method name="GetProperty">
      <arg name="id" type="i" direction="in"/>
      <arg name="name" type="s" direction="in"/>
      <arg name="value" type="v" direction="out"/>
    </method>
    <method name="Event">
      <arg name="id" type="i" direction="in"/>
      <arg name="eventId" type="s" direction="in"/>
      <arg name="data" type="v" direction="in"/>
      <arg name="timestamp" type="u" direction="in"/>
    </method>
    <method name="EventGroup">
      <arg name="events" type="a(isvu)" direction="in"/>
      <arg name="idErrors" type="ai" direction="out"/>
    </method>
    <method name="AboutToShow">
      <arg name="id" type="i" direction="in"/>
      <arg name="needUpdate" type="b" direction="out"/>
    </method>
    <method name="AboutToShowGroup">
      <arg name="ids" type="ai" direction="in"/>
      <arg name="updatesNeeded" type="ai" direction="out"/>
      <arg name="idErrors" type="ai" direction="out"/>
    </method>
    <signal name="ItemsPropertiesUpdated">
      <arg name="updatedProps" type="a(ia{sv})"/>
      <arg name="removedProps" type="a(ias)"/>
    </signal>
    <signal name="LayoutUpdated">
      <arg name="revision" type="u"/>
      <arg name="parent" type="i"/>
    </signal>
    <signal name="ItemActivationRequested">
      <arg name="id" type="i"/>
      <arg name="timestamp" type="u"/>
    </signal>
  </interface>
</node>
"""

ITEM_PROPERTIES = {
    "Category": GLib.Variant("s", "ApplicationStatus"),
    "Id": GLib.Variant("s", PLUGIN_ID),
    "Title": GLib.Variant("s", "Workspace Icons"),
    "Status": GLib.Variant("s", "Active"),
    "IconName": GLib.Variant("s", "workspace-icons-symbolic"),
    "IconThemePath": GLib.Variant("s", ICON_DIR),
    # A menu-only item: the tray opens the menu on any click.
    "ItemIsMenu": GLib.Variant("b", True),
    "Menu": GLib.Variant("o", MENU_PATH),
    "ToolTip": GLib.Variant("(sa(iiay)ss)", ("", [], "Workspace Icons", "")),
}

MENU_PROPERTIES = {
    "Version": GLib.Variant("u", 3),
    "TextDirection": GLib.Variant("s", "ltr"),
    "Status": GLib.Variant("s", "normal"),
    "IconThemePath": GLib.Variant("as", []),
}

SECTIONS = [("left", "Left"), ("center", "Center"), ("right", "Right")]


def run(*command):
    subprocess.Popen(list(command), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def read_state():
    """The widget's settings and bar placement, with the widget's defaults."""
    try:
        with open(SHELL_CONFIG) as file:
            layout = json.load(file).get("bar", {}).get("layout", {})
    except (OSError, ValueError, AttributeError):
        layout = {}
    main, section, symbol, logo = {}, "left", "", False
    for name, _ in SECTIONS:
        for entry in layout.get(name) or []:
            if not isinstance(entry, dict):
                continue
            if entry.get("id") == "omarchy.menu":
                logo = True
            if entry.get("id") != PLUGIN_ID:
                continue
            if entry.get("mode") == "symbol":
                symbol = name
            else:
                main, section = entry, name
    return {
        "showIcons": main.get("showIcons", True) is not False,
        "coloredIcons": main.get("coloredIcons", True) is not False,
        "tintStyle": "normal" if main.get("tintStyle") in ("normal", "greyscale") else "accent",
        "colorFocused": main.get("colorFocused", False) is True,
        "showNumbers": main.get("showNumbers", True) is not False,
        "omarchyLogo": logo,
        "widgetSection": section,
        "iconPosition": "left" if main.get("iconPosition") == "left" else "right",
        "symbolPosition": "tray" if main.get("symbolInTray") is True else (symbol or section),
    }


def build_menu(state):
    """The menu as (id, properties, children, action) tuples, action taking no arguments."""
    def toggle(item_id, label, key, visible=True):
        checked = state[key]
        if key == "omarchyLogo":
            action = (lambda: run("omarchy", "plugin", "disable", "omarchy.menu")) if checked else \
                     (lambda: run("omarchy", "bar", "put", "omarchy.menu", "--section", "left", "--index", "0"))
        else:
            action = lambda: run(CONFIG_SCRIPT, "set", key, json.dumps(not checked))
        return (item_id, {"label": label, "toggle-type": "checkmark", "toggle-state": int(checked),
                          "visible": visible}, [], action)

    def choice(item_id, label, current, options, act, visible=True):
        names = dict(options)
        children = [(item_id * 10 + i + 1, {"label": text, "toggle-type": "radio",
                                             "toggle-state": int(value == current)},
                     [], (lambda value=value: act(value)))
                    for i, (value, text) in enumerate(options)]
        return (item_id, {"label": f"{label}: {names.get(current, current)}", "children-display": "submenu",
                          "visible": visible}, children, None)

    tinted = not state["coloredIcons"]
    return (0, {"children-display": "submenu"}, [
        toggle(1, "App icons", "showIcons"),
        toggle(2, "Colored icons", "coloredIcons"),
        choice(3, "Tint", state["tintStyle"], [("accent", "Accent"), ("normal", "Normal")],
               lambda v: run(CONFIG_SCRIPT, "set", "tintStyle", json.dumps(v)), visible=tinted),
        toggle(4, "Color the focused workspace", "colorFocused", visible=tinted),
        toggle(5, "Workspace numbers", "showNumbers"),
        toggle(6, "Show Omarchy logo", "omarchyLogo"),
        (7, {"type": "separator"}, [], None),
        choice(8, "Bar section", state["widgetSection"], SECTIONS,
               lambda v: run(CONFIG_SCRIPT, "main", v)),
        choice(9, "Icon position", state["iconPosition"], [("left", "Left"), ("right", "Right")],
               lambda v: run(CONFIG_SCRIPT, "set", "iconPosition", json.dumps(v))),
        choice(10, "Plugin symbol", state["symbolPosition"], SECTIONS + [("tray", "Tray")],
               lambda v: run(CONFIG_SCRIPT, "symbol", v)),
    ], None)


def to_variants(properties):
    variants = {}
    for key, value in properties.items():
        if isinstance(value, bool):
            variants[key] = GLib.Variant("b", value)
        elif isinstance(value, int):
            variants[key] = GLib.Variant("i", value)
        else:
            variants[key] = GLib.Variant("s", str(value))
    return variants


class Menu:
    def __init__(self, bus):
        self.bus = bus
        self.revision = 1
        self.refresh()

    def refresh(self):
        self.root = build_menu(read_state())
        self.items = {}

        def index(item):
            self.items[item[0]] = item
            for child in item[2]:
                index(child)
        index(self.root)

    def changed(self):
        self.refresh()
        self.revision += 1
        self.bus.emit_signal(None, MENU_PATH, "com.canonical.dbusmenu", "LayoutUpdated",
                             GLib.Variant("(ui)", (self.revision, 0)))

    def layout(self, item, depth):
        item_id, properties, children, _ = item
        child_variants = [] if depth == 0 else \
            [GLib.Variant("(ia{sv}av)", self.layout(child, depth - 1)) for child in children]
        return (item_id, to_variants(properties), child_variants)

    def on_method_call(self, _conn, _sender, _path, _iface, method, params, invocation):
        args = params.unpack()
        if method == "GetLayout":
            parent_id, depth = args[0], args[1]
            item = self.items.get(parent_id, self.root)
            invocation.return_value(GLib.Variant("(u(ia{sv}av))", (self.revision, self.layout(item, depth))))
        elif method == "GetGroupProperties":
            ids = args[0] or list(self.items)
            result = [(i, to_variants(self.items[i][1])) for i in ids if i in self.items]
            invocation.return_value(GLib.Variant("(a(ia{sv}))", (result,)))
        elif method == "GetProperty":
            item = self.items.get(args[0])
            value = to_variants(item[1]).get(args[1]) if item else None
            invocation.return_value(GLib.Variant("(v)", (value or GLib.Variant("s", ""),)))
        elif method == "Event":
            self.event(args[0], args[1])
            invocation.return_value(None)
        elif method == "EventGroup":
            for event in args[0]:
                self.event(event[0], event[1])
            invocation.return_value(GLib.Variant("(ai)", ([],)))
        elif method == "AboutToShow":
            self.refresh()
            invocation.return_value(GLib.Variant("(b)", (True,)))
        elif method == "AboutToShowGroup":
            self.refresh()
            invocation.return_value(GLib.Variant("(aiai)", (list(args[0]), [])))
        else:
            invocation.return_value(None)

    def event(self, item_id, event_id):
        item = self.items.get(item_id)
        if event_id == "clicked" and item and item[3]:
            item[3]()

    def on_get_property(self, _conn, _sender, _path, _iface, name):
        return MENU_PROPERTIES.get(name)


def on_item_method_call(_conn, _sender, _path, _iface, _method, _params, invocation):
    # Menu-only item: activation has nothing else to do.
    invocation.return_value(None)


def on_item_get_property(_conn, _sender, _path, _iface, name):
    return ITEM_PROPERTIES.get(name)


def main():
    loop = GLib.MainLoop()
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)

    reply = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                          "RequestName", GLib.Variant("(su)", (UNIQUE_NAME, 4)),  # DO_NOT_QUEUE
                          GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, -1, None)
    if reply.unpack()[0] not in (1, 4):  # neither primary owner nor already owner
        return 0

    node = Gio.DBusNodeInfo.new_for_xml(INTERFACES)
    menu = Menu(bus)
    bus.register_object_with_closures2(ITEM_PATH, node.interfaces[0], on_item_method_call,
                                       on_item_get_property, None)
    bus.register_object_with_closures2(MENU_PATH, node.interfaces[1], menu.on_method_call,
                                       menu.on_get_property, None)

    # Keep the menu in step with settings changed elsewhere (popup, other tools).
    # Omarchy saves shell.json by moving a new file into place, so watch the folder.
    def on_config_changed(_monitor, file, other, _event):
        if SHELL_CONFIG in (file.get_path(), other.get_path() if other else None):
            menu.changed()

    monitor = Gio.File.new_for_path(os.path.dirname(SHELL_CONFIG)).monitor_directory(
        Gio.FileMonitorFlags.WATCH_MOVES, None)
    monitor.connect("changed", on_config_changed)

    def register(*_args):
        bus.call("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher", "org.kde.StatusNotifierWatcher",
                 "RegisterStatusNotifierItem", GLib.Variant("(s)", (bus.get_unique_name(),)),
                 None, Gio.DBusCallFlags.NONE, -1, None, None)

    # Register now and again whenever the tray host (re)starts.
    Gio.bus_watch_name_on_connection(bus, "org.kde.StatusNotifierWatcher", Gio.BusNameWatcherFlags.NONE,
                                     register, None)

    # Exit with the shell that started us.
    parent = os.getppid()

    def check_parent():
        if os.getppid() != parent:
            loop.quit()
            return False
        return True

    GLib.timeout_add_seconds(2, check_parent)
    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
